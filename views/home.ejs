<%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero-section d-flex align-items-center">
    <div class="container text-center text-white">
      <h1 class="display-3 fw-bold mb-3">Brewed Fresh,<br>Served with Love</h1>
      <p class="lead mb-4">Handcrafted coffee made from ethically sourced beans,<br>roasted to perfection in small batches.</p>
      <a href="/order" class="btn btn-coffee btn-lg px-5 py-3">
        <i class="bi bi-cup-hot me-2"></i>View Our Menu
      </a>
    </div>
  </section>

  <!-- Featured Coffees Section -->
  <section class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="section-title">Featured Drinks</h2>
        <p class="text-muted">Our most popular picks, crafted with care.</p>
      </div>
      <div class="row g-4">
        <% featured.forEach(coffee => { %>
          <div class="col-md-4">
            <div class="card coffee-card h-100 shadow-sm">
              <img src="<%= coffee.image %>" class="card-img-top" alt="<%= coffee.name %>">
              <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title mb-0"><%= coffee.name %></h5>
                  <span class="badge bg-coffee-badge"><%= coffee.category %></span>
                </div>
                <p class="card-text text-muted flex-grow-1"><%= coffee.description %></p>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                  <span class="price-tag">$<%= coffee.price.toFixed(2) %></span>
                  <a href="/order" class="btn btn-outline-coffee btn-sm">Order Now</a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-5 bg-light-cream">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="section-title">Why Choose Greenfield?</h2>
      </div>
      <div class="row g-4 text-center">
        <div class="col-md-4">
          <div class="p-4">
            <i class="bi bi-globe-americas display-4 text-coffee mb-3"></i>
            <h4>Ethically Sourced</h4>
            <p class="text-muted">We partner directly with farmers to ensure fair wages and sustainable growing practices.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-4">
            <i class="bi bi-fire display-4 text-coffee mb-3"></i>
            <h4>Small-Batch Roasted</h4>
            <p class="text-muted">Every batch is roasted in-house to bring out the unique character of each bean origin.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-4">
            <i class="bi bi-heart-fill display-4 text-coffee mb-3"></i>
            <h4>Made with Love</h4>
            <p class="text-muted">Our baristas are passionate about their craft, ensuring every cup is perfect.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
