<%- include('partials/header') %>

  <!-- About Hero -->
  <section class="about-hero d-flex align-items-center">
    <div class="container text-center text-white">
      <h1 class="display-4 fw-bold">Our Story</h1>
      <p class="lead">From a small idea to your favorite neighborhood coffee shop.</p>
    </div>
  </section>

  <!-- Our Story Section -->
  <section class="py-5">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <img src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=600&h=400&fit=crop" 
               alt="Coffee shop interior" class="img-fluid rounded shadow">
        </div>
        <div class="col-lg-6">
          <h2 class="section-title">How It All Started</h2>
          <p>Greenfield Coffee was born from a simple belief: that great coffee can bring people together and make the world a little better, one cup at a time.</p>
          <p>Founded in 2024, we started as a small pop-up at the local farmers' market. Word spread quickly about our carefully sourced beans and handcrafted drinks. Before long, we opened our first brick-and-mortar location right here in the heart of the community.</p>
          <p>Today, we continue to grow — but our commitment to quality, sustainability, and community remains at the core of everything we do.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values Section -->
  <section class="py-5 bg-light-cream">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="section-title">What We Stand For</h2>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center p-4">
            <div class="card-body">
              <i class="bi bi-tree-fill display-4 text-coffee mb-3"></i>
              <h4>Sustainability</h4>
              <p class="text-muted">From compostable cups to carbon-neutral shipping, we're committed to minimizing our environmental footprint.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center p-4">
            <div class="card-body">
              <i class="bi bi-star-fill display-4 text-coffee mb-3"></i>
              <h4>Quality</h4>
              <p class="text-muted">We source only the top 2% of beans from around the world and roast them in small batches for peak freshness.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center p-4">
            <div class="card-body">
              <i class="bi bi-people-fill display-4 text-coffee mb-3"></i>
              <h4>Community</h4>
              <p class="text-muted">We believe coffee shops are neighborhood living rooms. We host events, support local artists, and give back.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="section-title">Meet the Team</h2>
        <p class="text-muted">The people behind every perfect cup.</p>
      </div>
      <div class="row g-4 justify-content-center">
        <div class="col-md-4 col-lg-3 text-center">
          <div class="team-card p-4">
            <div class="team-avatar mb-3">
              <i class="bi bi-person-circle display-1 text-coffee"></i>
            </div>
            <h5>Maria Rodriguez</h5>
            <p class="text-muted mb-0">Founder & Head Roaster</p>
          </div>
        </div>
        <div class="col-md-4 col-lg-3 text-center">
          <div class="team-card p-4">
            <div class="team-avatar mb-3">
              <i class="bi bi-person-circle display-1 text-coffee"></i>
            </div>
            <h5>James Chen</h5>
            <p class="text-muted mb-0">Lead Barista</p>
          </div>
        </div>
        <div class="col-md-4 col-lg-3 text-center">
          <div class="team-card p-4">
            <div class="team-avatar mb-3">
              <i class="bi bi-person-circle display-1 text-coffee"></i>
            </div>
            <h5>Aisha Patel</h5>
            <p class="text-muted mb-0">Community Manager</p>
          </div>
        </div>
        <div class="col-md-4 col-lg-3 text-center">
          <div class="team-card p-4">
            <div class="team-avatar mb-3">
              <i class="bi bi-person-circle display-1 text-coffee"></i>
            </div>
            <h5>Sam Okafor</h5>
            <p class="text-muted mb-0">Pastry Chef</p>
          </div>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
