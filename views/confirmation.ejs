<%- include('partials/header') %>

<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm text-center">
          <div class="card-body p-5">
            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-3"></i>
            <h1 class="h3 mb-2">Order Confirmed!</h1>
            <p class="text-muted mb-3">Thanks for your order. We'll have it ready for pickup in about 15 minutes.</p>
            <div class="bg-light-cream rounded p-3 mb-4">
              <div class="small text-muted">Order Number</div>
              <div class="fw-bold fs-4"><%= orderNumber %></div>
            </div>
            <a class="btn btn-coffee" href="/order"><i class="bi bi-cup-hot me-1"></i>Back to Menu</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
